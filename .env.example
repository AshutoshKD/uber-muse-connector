# ================================================================
# UBER MUSE CONNECTOR — Environment Variables
# ================================================================
# Get Uber API keys at: https://developer.uber.com
# ================================================================

# ── Uber API Credentials ─────────────────────────────────────────
UBER_CLIENT_ID=your_uber_client_id_here
UBER_CLIENT_SECRET=your_uber_client_secret_here
UBER_SERVER_TOKEN=your_uber_server_token_here

# Uber API base URL
UBER_API_BASE_URL=https://api.uber.com/v1.2

# Set to 'sandbox' during dev, 'production' when live
UBER_ENV=sandbox

# ── Your Connector Secret ────────────────────────────────────────
# Muse sends this on every request to authenticate
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_SECRET_KEY=generate_a_random_32_char_string_here

# ── Server Config ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
